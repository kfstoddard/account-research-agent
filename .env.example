# Copy this file to .env and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Bright Data: one API key, plus the zone names from your dashboard
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1
# Optional, only needed for --max-fetches > 0 with the brightdata backend
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

TAVILY_API_KEY=

# Results returned per search (kept equal across backends for a fair test)
NUM_RESULTS=5
